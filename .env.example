# Copy to .env and set a password before running `docker compose up`.
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# Required — compose refuses to start without it.
POSTGRES_PASSWORD=change-me

# Optional, defaults shown.
POSTGRES_DB=shazam
POSTGRES_USER=shazam
LOG_LEVEL=INFO

# Only needed when running the API directly on the host rather than in compose.
# Inside compose this is set automatically and points at the `db` service.
# DATABASE_URL=postgresql://shazam:change-me@localhost:5432/shazam

# Read by the desktop client only, to point it at a server other than the
# default http://127.0.0.1:8000. The environment variable of the same name wins
# over this file, and the API URL box in the app window wins over both.
# API_BASE_URL=http://127.0.0.1:8000
